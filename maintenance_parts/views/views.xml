<?xml version="1.0" encoding="utf-8"?>
<openerp>
  <data>
    <record id="equipment_parts_form" model="ir.ui.view" >
        <field name="name">maintenance.equipment.parts.form</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field eval="20" name="priority"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Parts">
                    <field name="part_ids" context="{'default_type':'parts',}">
                        <tree>
                            <field name="default_code"/>
                            <field name="name"/>
                            <field name="qty_available"/>
                            <field name="virtual_available"/>
                            <field name="standard_price"/>
                            <field name="lst_price"/>
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
    
    <record id="maintenance_request_parts_form" model="ir.ui.view" >
        <field name="name">maintenance.request.parts.form</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="base_maintenance.equipment_request_view_form"/>
        <field eval="20" name="priority"/>
        <!-- <field name="context">{'default_location_id': ref('maintenance_parts.maintenance_parts_location'),'default_location_dest_id': ref('maintenance_parts.maintenance_parts_consumed')}</field> -->
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                
                <page name="parts" string="Parts">
                    <field name="_barcode_scanned" widget="barcode_handler"/>
                    <button name="action_assign_parts" string="Check Parts Availability" type="object" class="oe_highlight"/>
                    <button name="action_mark_parts_done" string="Finish Parts" type="object" class="oe_highlight"/>
                    <field name="part_move_ids">
                      <!--  decoration-muted="state == 'cancel' or (state == 'done' and is_locked == True)" -->
                        <tree delete="1" default_order="sequence" decoration-danger="state != 'done' and quantity_done > reserved_availability">
                            <field name="product_id" required="1"/>
                            <field name="name" invisible="1"/>
                            <!--<field name="unit_factor" invisible="1"/>-->                            
                            <field name="has_tracking" invisible="1"/>
                            <!--<field name="needs_lots" readonly="1" groups="stock.group_production_lot"/>-->
                            <field name="is_done" invisible="1"/>
                            <field name="sequence" invisible="1"/>
                            <field name="location_id"/>
                            <!-- <field name="location_dest_id"/> -->                            
                            <field name="product_uom_qty" string="To Consume"/>
                            <field name="product_uom" groups="uom.group_uom"/>
                            <field name="reserved_availability" attrs="{'invisible': [('is_done', '=', True)]}" string="Reserved"/>
                            <field name="quantity_done" string="Consumed" />                            
                            <field name="state" invisible="0" force_save="1"/>
                            <button name="action_show_details" string="Consume" type="object" class="oe_highlight" attrs="{'invisible': [('is_done', '=', True)]}"/>
                        </tree>
                        <form>
                            <group>
                                <group>
                                    <field name="product_id" required="1"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                </group>
                                <group>
                                    <field name="product_uom_qty" string="To Consume"/>
                                    <field name="reserved_availability" attrs="{'invisible': [('is_done', '=', True)]}" string="Reserved"/>
                                    <field name="quantity_done" string="Consumed" readonly="1"/>                            
                                </group>
                                <field name="move_line_ids"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
      
  </data>
</openerp>